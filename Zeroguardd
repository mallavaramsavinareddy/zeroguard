@app.get("/auth/status")
def auth_status(request: Request):
    """
    Check if the current session is valid and return
    connected user email.
    """

    session_token = get_session_token_from_request(
        request
    )

    if not session_token:
        log_trace(
            "Auth status check: "
            "No session token header provided."
        )

        return {
            "status": "success",
            "connected": False,
            "email": None
        }

    user_info = get_user_by_session(
        session_token
    )

    if not user_info:
        log_trace(
            f"Auth status check: "
            f"Session {session_token[:8]}... "
            "not found or expired in DB."
        )

        return {
            "status": "success",
            "connected": False,
            "email": None
        }

    log_trace(
        f"Auth status check: "
        f"Session {session_token[:8]}... "
        f"active for user {user_info}"
    )

    return {
        "status": "success",
        "connected": True,
        "email": user_info
    }


