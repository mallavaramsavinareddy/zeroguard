class MessageAnalysisRequest(BaseModel):
    message: str = ""
    url: str = ""


@app.post("/analyze-message")
def analyze_message_endpoint(payload: MessageAnalysisRequest):
    """
    Analyze a manually pasted message and/or URL from SMS, WhatsApp,
    LinkedIn, Instagram, or direct message for phishing threats.
    """
    message = (payload.message or "").strip()
    url = (payload.url or "").strip()

    if not message and not url:
        return JSONResponse(
            status_code=400,
            content={
                "status": "error",
                "message": "Please provide a message or URL to analyze."
            }
        )

    try:
        result = analyze_message(message=message, url=url)
        return {
            "status": "success",
            "risk_score": result["risk_score"],
            "severity": result["severity"],
            "reasons": result["reasons"],
            "detected_urls": result["detected_urls"],
            "recommendation": result["recommendation"],
            "ai_analysis": result.get("ai_analysis", {})
        }
    except Exception as e:
        traceback.print_exc()
        return JSONResponse(
            status_code=500,
            content={
                "status": "error",
                "message": f"Failed to analyze message: {str(e)}"
            }
        )


