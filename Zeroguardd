# ============================================================
# GOOGLE OAUTH CALLBACK
# ============================================================

@app.get("/auth/google/callback")
def auth_google_callback(request: Request):
    """
    Handle Google OAuth callback, exchange authorization code
    for tokens, create an isolated user session, and redirect
    back to the frontend.

    Handles duplicate callbacks gracefully.
    """

    error = request.query_params.get("error")
    code = request.query_params.get("code")
    state = request.query_params.get("state")

    log_trace(
        f"Callback received: error={error} | "
        f"has_code={bool(code)} | "
        f"state={state[:8] if state else 'None'}..."
    )

    # --------------------------------------------------------
    # GOOGLE RETURNED AN ERROR
    # --------------------------------------------------------

    if error:
        log_trace(
            f"Google returned error in OAuth callback: {error}"
        )

        return RedirectResponse(
            url=(
                f"{FRONTEND_URL}/"
                f"?auth_error="
                f"{urllib.parse.quote(error)}"
            ),
            status_code=307
        )

    # --------------------------------------------------------
    # MISSING CODE OR STATE
    # --------------------------------------------------------

    if not code or not state:
        log_trace(
            "Callback missing code or state parameter."
        )

        return RedirectResponse(
            url=(
                f"{FRONTEND_URL}/"
                f"?auth_error=missing_code_or_state"
            ),
            status_code=307
        )

    try:
        # Determine callback redirect URI.
        fallback_redirect_uri = str(
            request.url_for(
                "auth_google_callback"
            )
        )

        # ----------------------------------------------------
        # HANDLE OAUTH CALLBACK
        # ----------------------------------------------------

        result = handle_oauth_callback(
            code=code,
            state=state,
            fallback_redirect_uri=fallback_redirect_uri
        )

        # IMPORTANT:
        # handle_oauth_callback() returns a dictionary.
        session_token = result["session_token"]
        user_email = result["email"]
        frontend_url = result["frontend_url"]

        log_trace(
            f">>> OAuth successful for {user_email}"
        )

        log_trace(
            ">>> Redirecting user to frontend"
        )

        # ----------------------------------------------------
        # BUILD FRONTEND REDIRECT URL
        # ----------------------------------------------------

        redirect_url = (
            f"{frontend_url}/"
            f"?session_token="
            f"{urllib.parse.quote(session_token)}"
            f"&email="
            f"{urllib.parse.quote(user_email)}"
            f"&status=connected"
        )

        return RedirectResponse(
            url=redirect_url,
            status_code=307
        )

    except Exception as e:
        log_trace(
            f"!!! OAuth callback exception: "
            f"{type(e).__name__}: {str(e)}"
        )

        traceback.print_exc()

        err_msg = urllib.parse.quote(
            str(e)
        )

        return RedirectResponse(
            url=(
                f"{FRONTEND_URL}/"
                f"?auth_error={err_msg}"
            ),
            status_code=307
        )


