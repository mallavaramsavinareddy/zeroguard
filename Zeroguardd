@app.get("/quarantine")
def get_quarantined_emails(
    request: Request
):

    session_token = get_session_token_from_request(
        request
    )

    try:

        service = get_gmail_service_for_user(
            session_token
        )

    except RuntimeError as e:

        return JSONResponse(
            status_code=401,
            content={
                "status": "unauthenticated",
                "connected": False,
                "error": str(e),
                "emails": []
            }
        )

    except Exception as e:

        return JSONResponse(
            status_code=500,
            content={
                "status": "error",
                "error": str(e)
            }
        )

    try:

        labels_response = (
            service.users()
            .labels()
            .list(userId="me")
            .execute()
        )

        labels = labels_response.get(
            "labels",
            []
        )

        quarantine_label_id = None

        for label in labels:

            if label.get("name") == "ZeroGuard-Quarantine":

                quarantine_label_id = label.get(
                    "id"
                )

                break

        if quarantine_label_id is None:

            return {
                "status": "success",
                "connected": True,
                "count": 0,
                "emails": []
            }

        messages_response = (
            service.users()
            .messages()
            .list(
                userId="me",
                labelIds=[quarantine_label_id],
                maxResults=50
            )
            .execute()
        )

        messages = messages_response.get(
            "messages",
            []
        )

        quarantined_emails = []

        for message in messages:

            message_id = message["id"]

            try:

                msg = (
                    service.users()
                    .messages()
                    .get(
                        userId="me",
                        id=message_id,
                        format="full"
                    )
                    .execute()
                )

                payload = msg.get(
                    "payload",
                    {}
                )

                headers = payload.get(
                    "headers",
                    []
                )

                sender = ""
                subject = ""

                for header in headers:

                    name = header.get(
                        "name",
                        ""
                    ).lower()

                    if name == "from":

                        sender = header.get(
                            "value",
                            ""
                        )

                    elif name == "subject":

                        subject = header.get(
                            "value",
                            ""
                        )

                body = ""

                def extract_q_body(part):

                    nonlocal body

                    mime_type = part.get(
                        "mimeType",
                        ""
                    )

                    data = part.get(
                        "body",
                        {}
                    ).get(
                        "data"
                    )

                    if mime_type == "text/plain" and data:

                        try:

                            import base64

                            padding = "=" * (
                                -len(data) % 4
                            )

                            decoded = (
                                base64.urlsafe_b64decode(
                                    data + padding
                                )
                            )

                            body += decoded.decode(
                                "utf-8",
                                errors="ignore"
                            )

                        except Exception:
                            pass

                    for child in part.get(
                        "parts",
                        []
                    ):

                        extract_q_body(
                            child
                        )

                extract_q_body(
                    payload
                )

                links = re_extract_urls(
                    body
                )

                security = analyze_email(
                    sender,
                    subject,
                    body,
                    links
                )

                security["quarantined"] = True

                security["quarantine"] = {
                    "status": "quarantined",
                    "reason": (
                        "Email is stored in "
                        "ZeroGuard quarantine"
                    )
                }

                quarantined_emails.append({
                    "id": message_id,
                    "sender": sender,
                    "subject": subject,
                    "body": body,
                    "links": links,
                    "mailbox": "QUARANTINE",
                    "security": security
                })

            except Exception as e:

                print(
                    "Warning: Failed to fetch "
                    f"quarantined email "
                    f"{message_id}: {e}"
                )

                continue

        return {
            "status": "success",
            "connected": True,
            "count": len(quarantined_emails),
            "emails": quarantined_emails
        }

    except Exception as e:

        return JSONResponse(
            status_code=500,
            content={
                "status": "error",
                "error": str(e)
            }
        )


# ============================================================
# URL EXTRACTION
# ============================================================

def re_extract_urls(text):

    if not text:
        return []

    urls = re.findall(
        r'https?://[^\s<>"\']+',
        text,
        flags=re.IGNORECASE
    )

    cleaned = []

    for url in urls:

        url = url.rstrip(
            ".,!?;:)"
        )

        if url not in cleaned:
            cleaned.append(url)

    return cleaned