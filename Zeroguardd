@app.get("/auth/google/login")
def auth_google_login(request: Request):
    """
    Direct browser redirect to Google OAuth consent screen.
    Records initiating frontend_url and redirect_uri in DB state.
    """

    try:
        # Determine initiating frontend origin
        frontend_url = (
            request.query_params.get("frontend_url")
            or request.headers.get("referer")
            or FRONTEND_URL
        )

        if frontend_url.endswith("/"):
            frontend_url = frontend_url.rstrip("/")

        # Determine redirect URI
        configured_redirect = os.getenv(
            "GOOGLE_REDIRECT_URI"
        )

        redirect_uri = (
            configured_redirect
            or str(
                request.url_for(
                    "auth_google_callback"
                )
            )
        )

        auth_url, state = generate_auth_url(
            redirect_uri=redirect_uri,
            frontend_url=frontend_url
        )

        return RedirectResponse(
            url=auth_url,
            status_code=307
        )

    except Exception as e:
        log_trace(
            f"!!! Failed to initiate Google OAuth: "
            f"{type(e).__name__}: {str(e)}"
        )

        traceback.print_exc()

        return JSONResponse(
            status_code=500,
            content={
                "status": "error",
                "message": (
                    "Failed to initiate Google OAuth: "
                    f"{str(e)}"
                )
            }
        )


