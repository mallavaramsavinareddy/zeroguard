@app.get("/emails")
def emails(request: Request):

    session_token = get_session_token_from_request(
        request
    )

    try:
        service = get_gmail_service_for_user(
            session_token
        )

    except RuntimeError as e:

        return JSONResponse(
            status_code=401,
            content={
                "status": "unauthenticated",
                "connected": False,
                "error": str(e),
                "emails": []
            }
        )

    except Exception as e:

        return JSONResponse(
            status_code=500,
            content={
                "status": "error",
                "error": (
                    "Failed to initialize Gmail client: "
                    f"{str(e)}"
                )
            }
        )

    try:

        raw_emails = get_latest_emails(
            service=service,
            max_results=10
        )

        analyzed_emails = []

        for email in raw_emails:

            message_id = email.get("id")
            sender = email.get("sender", "")
            subject = email.get("subject", "")
            body = email.get("body", "")
            links = email.get("links", [])
            link_details = email.get(
                "link_details",
                []
            )
            mailbox = email.get(
                "mailbox",
                "INBOX"
            )

            # ------------------------------------------------
            # ZERO GUARD SECURITY ANALYSIS
            # ------------------------------------------------

            analysis = analyze_email(
                sender,
                subject,
                body,
                links,
                link_details=link_details
            )

            # ------------------------------------------------
            # ATTACHMENT SECURITY ANALYSIS
            # ------------------------------------------------
            # This is additive to the existing email analysis.
            # If there are no attachments, the existing email
            # risk and behaviour remain unchanged.

            attachment_results = analyze_attachments(
                email.get("attachments", [])
            )

            email["attachments"] = attachment_results

            # ------------------------------------------------
            # Merge attachment risk with existing email risk.
            # Attachment risk can increase the final risk, but
            # it can never reduce the existing email risk.
            # ------------------------------------------------

            risk_order = {
                "LOW": 0,
                "MEDIUM": 1,
                "HIGH": 2,
                "CRITICAL": 3
            }

            email_risk = analysis.get(
                "risk_level",
                "LOW"
            )

            attachment_risk = attachment_results.get(
                "risk_level",
                "LOW"
            )

            if risk_order.get(
                attachment_risk,
                0
            ) > risk_order.get(
                email_risk,
                0
            ):

                analysis["risk_level"] = attachment_risk

                analysis["risk_score"] = max(
                    analysis.get(
                        "risk_score",
                        0
                    ),
                    attachment_results.get(
                        "risk_score",
                        0
                    )
                )

                analysis.setdefault(
                    "reasons",
                    []
                ).append(
                    "Suspicious attachment detected."
                )

                if attachment_risk in (
                    "HIGH",
                    "CRITICAL"
                ):

                    analysis.setdefault(
                        "intent",
                        {}
                    )["recommended_defense"] = (
                        "Quarantine"
                    )

            email["security"] = analysis

            risk_level = analysis.get(
                "risk_level",
                "LOW"
            )

            # =================================================
            # DECISION ENGINE
            # =================================================

            # HIGH and CRITICAL emails are automatically quarantined.
            # MEDIUM and LOW emails remain in the Inbox.

            if risk_level in ("HIGH", "CRITICAL"):

                try:

                    quarantine_result = quarantine_email(
                        message_id,
                        service=service
                    )

                    email["security"][
                        "quarantine"
                    ] = quarantine_result

                    email["security"][
                        "quarantined"
                    ] = True

                    email["mailbox"] = "QUARANTINE"

                except Exception as e:

                    email["security"][
                        "quarantine"
                    ] = {
                        "status": "error",
                        "message": (
                            "Failed to quarantine email"
                        ),
                        "error": str(e)
                    }

                    email["security"][
                        "quarantined"
                    ] = False

            # -------------------------------------------------
            # MEDIUM
            # -------------------------------------------------

            elif risk_level == "MEDIUM":

                if mailbox == "SPAM":

                    try:

                        move_result = move_to_inbox(
                            message_id,
                            service=service
                        )

                        email["security"][
                            "quarantine"
                        ] = {
                            "status": "not_quarantined",
                            "reason": (
                                "ZeroGuard analyzed "
                                "the email as MEDIUM risk "
                                "and moved it from Gmail "
                                "Spam to Inbox."
                            ),
                            "gmail_action": move_result
                        }

                        email["security"][
                            "quarantined"
                        ] = False

                        email["mailbox"] = "INBOX"

                    except Exception as e:

                        email["security"][
                            "quarantine"
                        ] = {
                            "status": "error",
                            "message": (
                                "Failed to move email "
                                "from Spam to Inbox"
                            ),
                            "error": str(e)
                        }

                        email["security"][
                            "quarantined"
                        ] = False

                else:

                    email["security"][
                        "quarantine"
                    ] = {
                        "status": "not_quarantined",
                        "reason": (
                            "Email risk level is MEDIUM. "
                            "It remains in the Inbox for "
                            "user review."
                        )
                    }

                    email["security"][
                        "quarantined"
                    ] = False

            # -------------------------------------------------
            # LOW
            # -------------------------------------------------

            else:

                if mailbox == "SPAM":

                    try:

                        move_result = move_to_inbox(
                            message_id,
                            service=service
                        )

                        email["security"][
                            "quarantine"
                        ] = {
                            "status": "not_quarantined",
                            "reason": (
                                "ZeroGuard analyzed "
                                "the email as LOW risk "
                                "and moved it from Gmail "
                                "Spam to Inbox."
                            ),
                            "gmail_action": move_result
                        }

                        email["security"][
                            "quarantined"
                        ] = False

                        email["mailbox"] = "INBOX"

                    except Exception as e:

                        email["security"][
                            "quarantine"
                        ] = {
                            "status": "error",
                            "message": (
                                "Failed to move email "
                                "from Spam to Inbox"
                            ),
                            "error": str(e)
                        }

                        email["security"][
                            "quarantined"
                        ] = False

                else:

                    email["security"][
                        "quarantine"
                    ] = {
                        "status": "not_quarantined",
                        "reason": (
                            "Email risk level is LOW. "
                            "It remains in the Inbox."
                        )
                    }

                    email["security"][
                        "quarantined"
                    ] = False

            analyzed_emails.append(
                email
            )

        return {
            "status": "success",
            "connected": True,
            "count": len(analyzed_emails),
            "emails": analyzed_emails
        }

    except Exception as e:

        return JSONResponse(
            status_code=500,
            content={
                "status": "error",
                "error": str(e)
            }
        )


